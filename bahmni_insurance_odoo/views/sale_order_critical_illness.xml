<record id="sale_order_critical_illness_form" model="ir.ui.view">
    <field name="name">sale.order.form.critical.illness</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <field name="partner_id" position="after">
            <field name="critical_illness_code"
                   attrs="{'invisible': [('payment_type', '!=', 'insurance')]}"/>
        </field>
    </field>
</record>
